APP_NAME="Visa Application System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Pepper for the passport-number blind index (Backend_schema.md §13.2). Generate
# a fresh random value per environment — never share one across environments,
# never commit a real value here.
BLIND_INDEX_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: MariaDB 11.8.8 on Hostinger — verified wire-compatible with the
# MySQL-8-oriented schema in Backend_schema.md (CHECK constraints, generated
# columns, SIGNAL SQLSTATE triggers, ascii_bin/utf8mb4_0900_ai_ci collations
# all confirmed). Local dev (as of 2026-08-20): MAMP Pro MySQL 5.7 — see
# CLAUDE.md's "known gap" note on CHECK constraints not enforcing below 8.0.16.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 — Mumbai (ap-south-1), per the data-residency requirement
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
